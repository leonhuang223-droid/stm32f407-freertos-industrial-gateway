{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "F407: Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "problemMatcher": []
    },
    {
      "label": "F407: Build All",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--parallel"],
      "dependsOn": "F407: Configure Debug",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "F407: Build App A",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "f407_app_a"],
      "dependsOn": "F407: Configure Debug",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Host: Configure",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "host-debug"],
      "problemMatcher": []
    },
    {
      "label": "Host: Build",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "host-debug", "--parallel"],
      "dependsOn": "Host: Configure",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Host: Test",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "host-debug"],
      "dependsOn": "Host: Build",
      "problemMatcher": []
    }
  ]
}
