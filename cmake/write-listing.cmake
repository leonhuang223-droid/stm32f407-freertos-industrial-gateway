if(NOT DEFINED OBJDUMP_TOOL OR NOT DEFINED ELF_FILE OR NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "OBJDUMP_TOOL, ELF_FILE, and OUTPUT_FILE are required")
endif()

execute_process(
    COMMAND "${OBJDUMP_TOOL}" -h -S "${ELF_FILE}"
    RESULT_VARIABLE OBJDUMP_RESULT
    OUTPUT_FILE "${OUTPUT_FILE}"
    ERROR_VARIABLE OBJDUMP_ERROR
)

if(NOT OBJDUMP_RESULT EQUAL 0)
    message(FATAL_ERROR "arm-none-eabi-objdump failed: ${OBJDUMP_ERROR}")
endif()
